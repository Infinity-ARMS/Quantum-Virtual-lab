# Copy to .env (never commit .env). All values are read by the server only.

# Required: HMAC secret for session tokens, at least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Production database: PostgreSQL connection URL. On Vercel this is provided automatically by the Neon
# integration (pooled URL). Leave empty locally to use the SQLite file below.
DATABASE_URL=

# Local SQLite database file (used when DATABASE_URL is empty; created and migrated automatically).
DB_PATH=data/qlme.sqlite
PORT=8787
SESSION_TTL_HOURS=8
# Secure cookies default to on when NODE_ENV=production; only set false for plain-HTTP testing.
# COOKIE_SECURE=true   (set to true on Vercel)

# Optional account seeding for `npm run seed` (leave empty in production after first use).
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# comma-separated username:password pairs, created with role = user.
# Quote values that contain "#" (otherwise the rest of the line is treated as a comment).
SEED_STUDENTS=
